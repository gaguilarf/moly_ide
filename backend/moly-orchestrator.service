[Unit]
Description=Moly Orchestrator Backend API (Jetson Orin Nano)
# PostgreSQL vive en un contenedor, no en el host: sin docker no hay base.
After=network-online.target docker.service
Wants=network-online.target docker.service
# Va en [Unit], no en [Service]: puesto en la otra seccion systemd lo ignora en
# silencio y el arranque en bucle -por ejemplo, si falta una variable
# obligatoria- se rinde a los 5 intentos y el servicio se queda abajo.
StartLimitIntervalSec=0

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/moly_backend
EnvironmentFile=/home/jetson/moly_backend/.env
# Un solo worker, y no es por ahorrar: el orquestador guarda en memoria del
# proceso los WebSocket registrados y el estado del freno duro. Con dos workers,
# la pregunta de Claude se queda en uno y el movil habla con el otro.
ExecStart=/home/jetson/moly_backend/venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
